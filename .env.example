# Copy this to .env for local testing (Render: set these as Environment
# Variables in the dashboard instead — do NOT upload a .env file there).

TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token-from-BotFather
GEMINI_API_KEY=your-gemini-api-key

# Optional. Comma-separated Telegram chat_ids allowed to use the bot.
# Leave empty to allow anyone who finds the bot to chat with it.
# Get your own chat_id by messaging @userinfobot on Telegram.
ALLOWED_CHAT_IDS=

# Optional overrides
GEMINI_MODEL=gemini-2.5-flash
MEMORY_DIR=memory

# Admin's own Telegram chat_id — enables /broadcast, admin panel button,
# and Misumi AI Pro approval requests.
ADMIN_ID=

# --- Userbot feature ("AI ga akkount ulash" / Misumi AI Pro) ---
# Free API credentials from https://my.telegram.org/apps — required to
# let people connect their personal Telegram account.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Encryption key for stored userbot session strings. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# REQUIRED in production — without it, sessions are encrypted with a
# key generated on the fly and lost on redeploy (people will need to
# reconnect their account).
USERBOT_ENC_KEY=

# --- Sayt: bepul foydalanuvchilar kunlik limiti ---
# Kuniga nechta so'rov (kodda default 250, 0 = cheksiz). Kun chegarasi Toshkent vaqti (UTC+5).
# Admin panelda o'zgartirilsa, o'sha qiymat (bazada saqlanadi) shu env'dan ustun turadi.
FREE_DAILY_LIMIT=250
FREE_HOURLY_LIMIT=100  # bepul foydalanuvchi soatiga (0 = o'chiq)

# Majburiy obuna kanali (/start bosganda shu kanalga obuna bo'lish talab qilinadi).
# Bot shu kanalda ADMIN bo'lishi shart. Bo'sh qoldirilsa — o'chiq.
REQUIRED_CHANNEL=@misumiai

# --- ⭐ Telegram Stars to'lovi (payments.py) --- narxlar Stars'da
STARS_PRO_30=50
STARS_PRO_90=130
STARS_MAX_30=110

# --- 🤝 Referral (referral.py) ---
REF_INVITER_DAYS=3   # taklif qilgan odamga Pro kunlari
REF_INVITEE_DAYS=1   # taklif qilingan yangi odamga Pro kunlari
REF_MAX_REWARDS=30   # bitta odam ko'pi bilan nechta taklif uchun mukofot oladi
